<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <AssemblyVersion>0.3.2</AssemblyVersion>
        <FileVersion>0.3.2</FileVersion>
        <InformationalVersion>0.3.2</InformationalVersion>

        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <PropertyGroup>
        <Version>0.3.2</Version>
        <PackageId>Kokoabim.CommandLineInterface</PackageId>
        <Description>Console tool command-line interface library.</Description>
        <TargetFramework>net10.0</TargetFramework>

        <PackageVersion>0.3.3</PackageVersion>
        <PackageReleaseNotes></PackageReleaseNotes>

        <Authors>Spencer James</Authors>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>

        <PackageProjectUrl>https://github.com/kokoabim/CommandLineInterface-DotNet</PackageProjectUrl>
        <RepositoryUrl>https://github.com/kokoabim/CommandLineInterface-DotNet</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
    </PropertyGroup>

</Project>
